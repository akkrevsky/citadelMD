# Postgres
POSTGRES_DB=mdcollab
POSTGRES_USER=mdcollab
POSTGRES_PASSWORD=change_me_to_long_random_string

# MinIO
MINIO_ROOT_USER=mdcollab
MINIO_ROOT_PASSWORD=change_me_to_long_random_string
MINIO_BUCKET=md-collab-uploads

# JWT
JWT_SECRET=generate_with_openssl_rand_hex_32

# Initial admin
ADMIN_PASSWORD=change_me_initial

# Git repo (host path)
GIT_REPO_HOST_PATH=/var/lib/md-collab/docs

# Public URL
PUBLIC_BASE_URL=https://md.example.com

# Remote Git mirror (backup)
GIT_REMOTE_MIRROR_URL=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your-token-here
ANTHROPIC_MODEL=deepseek-v4-pro[1m]

# ===== AI Agent (dsh) =====
# DeepSeek platform API key for the agent LLM (native API; the same sk- token
# as ANTHROPIC_AUTH_TOKEN usually works).
DEEPSEEK_API_KEY=your-deepseek-platform-key-here
# LLM endpoint base; leave as the public API unless you use a proxy/gateway
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Agent model id on the native DeepSeek API (catalog: deepseek-v4-flash,
# deepseek-v4-pro, deepseek-v4-flash-vision-exp). NOT the Anthropic-compat id.
DSH_MODEL=deepseek-v4-pro
# apiKey of the `harness` service user — generated by `make -C infra agent-key`
DSH_MCP_TOKEN=generated_by_provision-agent.sh
