# citadelMD local debug stack
# Isolated ports — runs alongside the full Docker stack without conflicts.
#
# Quick start:
#   make -C infra debug-setup   # infra + migrate + seed
#   pnpm dev:debug              # hot-reload all apps on debug ports
#
# Open: http://localhost:5174  (login: admin / admin123)

# --- Docker infra (host ports) ---
POSTGRES_DB=mdcollab_debug
POSTGRES_USER=mdcollab
POSTGRES_PASSWORD=debug_local_only
POSTGRES_PORT=5433

REDIS_PORT=6380

MINIO_ROOT_USER=mdcollab
MINIO_ROOT_PASSWORD=debug_local_only
MINIO_BUCKET=md-collab-uploads-debug
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# --- Local app ports (tsx / vite, no container rebuild) ---
WEB_PORT=5174
BACKEND_PORT=3001
YJS_HTTP_PORT=1236
YJS_WS_PORT=1237
MCP_PORT=3101

# --- App connection strings ---
DATABASE_URL=postgresql://mdcollab:debug_local_only@localhost:5433/mdcollab_debug
REDIS_URL=redis://localhost:6380

JWT_SECRET=debug-jwt-secret-at-least-256-bits-long-do-not-use-in-production-012345
ADMIN_PASSWORD=admin123

GIT_REPO_HOST_PATH=/home/sp/md-collab-docs-debug
GIT_REPO_PATH=/home/sp/md-collab-docs-debug

MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=mdcollab
MINIO_SECRET_KEY=debug_local_only

YJS_SERVER_URL=http://localhost:1236
BACKEND_API_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001
MCP_SERVER_URL=http://localhost:3101
PUBLIC_BASE_URL=http://localhost:5174

# backend reads PORT; yjs/mcp override PORT in their dev:debug scripts
PORT=3001
